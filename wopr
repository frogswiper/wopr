#!/usr/bin/env bash
# Start the W.O.P.R. terminal server (if not already up) and open it full screen in its own window.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Optional config written by install.sh: WOPR_MODEL, WOPR_NODE, WOPR_PORT, WOPR_TTS, OLLAMA_URL ...
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/wopr/wopr.env"
if [ -f "$CONF" ]; then set -a; . "$CONF"; set +a; fi

PORT="${WOPR_PORT:-1983}"
URL="http://127.0.0.1:$PORT/"
NODE="${WOPR_NODE:-node}"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/wopr.log"
mkdir -p "$(dirname "$LOG")"

if ! curl -s -o /dev/null "${URL}wopr.json"; then
  nohup "$NODE" "$DIR/server.js" > "$LOG" 2>&1 &
  for _ in $(seq 25); do curl -s -o /dev/null "${URL}wopr.json" && break; sleep 0.2; done
fi

# Kiosk window with a dedicated browser profile: separate window, full screen, no browser chrome,
# audio allowed without a click (so Joshua can speak first) and location allowed for this page only.
# Leave with Esc (or Alt+F4).
#   WOPR_BROWSER=auto      Firefox, else Chrome / Chromium / Brave / Edge   (default)
#   WOPR_BROWSER=chrome    a Chromium-family browser only
#   WOPR_BROWSER=firefox   Firefox only
#   WOPR_BROWSER=default   a normal tab in the desktop's default browser
open_default() {
  if command -v xdg-open >/dev/null; then xdg-open "$URL" >/dev/null 2>&1 &
  elif command -v open >/dev/null; then open "$URL"
  else echo "W.O.P.R. is running at $URL"; fi
}

is_snap() {   # Ubuntu ships /usr/bin/firefox and /usr/bin/chromium-browser as wrappers around snaps
  local p; p="$(command -v "$1")" || return 1
  case "$p" in /snap/*) return 0 ;; esac                      # /snap/bin/<name> -> /usr/lib/snapd/snapd
  case "$(readlink -f "$p")" in /snap/*|*/snapd/snapd) return 0 ;; esac
  grep -qs "/snap/bin/" "$p"
}

open_firefox() {
  command -v firefox >/dev/null || return 1
  # Snap Firefox cannot read hidden directories, so its profile lives under ~/snap.
  if is_snap firefox; then PROFILE="$HOME/snap/firefox/common/wopr-profile"
  else PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/wopr/firefox-profile"; fi
  mkdir -p "$PROFILE"
  cat > "$PROFILE/user.js" <<'PREFS'
user_pref("media.autoplay.default", 0);
user_pref("media.autoplay.blocking_policy", 0);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("trailhead.firstrun.didSeeAboutWelcome", true);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("startup.homepage_welcome_url", "");
user_pref("startup.homepage_welcome_url.additional", "");
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.translations.automaticallyPopup", false);
user_pref("signon.rememberSignons", false);
user_pref("dom.allow_scripts_to_close_windows", true);
user_pref("permissions.default.geo", 1);
PREFS
  nohup firefox --profile "$PROFILE" --kiosk --new-window "$URL" >/dev/null 2>&1 &
}

open_chromium() {
  local b s
  for b in google-chrome google-chrome-stable chromium chromium-browser brave-browser microsoft-edge microsoft-edge-stable vivaldi; do
    command -v "$b" >/dev/null || continue
    if is_snap "$b"; then   # snaps may only write under ~/snap/<snap name>
      case "$b" in chromium*) s=chromium ;; brave*) s=brave ;; *) s="$b" ;; esac
      PROFILE="$HOME/snap/$s/common/wopr-profile"
    else PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/wopr/chromium-profile"; fi
    mkdir -p "$PROFILE/Default"
    # First run: pre-allow location for this page and skip the welcome / restore bubbles.
    if [ ! -s "$PROFILE/Default/Preferences" ]; then
      printf '{"profile":{"exit_type":"Normal","exited_cleanly":true,"content_settings":{"exceptions":{"geolocation":{"http://127.0.0.1:%s,*":{"setting":1}}}}},"browser":{"check_default_browser":false,"has_seen_welcome_page":true},"translate":{"enabled":false}}\n' "$PORT" > "$PROFILE/Default/Preferences"
    else
      sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' "$PROFILE/Default/Preferences"
    fi
    nohup "$b" --user-data-dir="$PROFILE" --kiosk --app="$URL" --autoplay-policy=no-user-gesture-required \
      --no-first-run --no-default-browser-check --password-store=basic --disable-features=Translate \
      --disable-session-crashed-bubble >/dev/null 2>&1 &
    return 0
  done
  return 1
}

case "${WOPR_BROWSER:-auto}" in
  default) open_default ;;
  firefox) open_firefox || open_default ;;
  chrome|chromium) open_chromium || open_default ;;
  *) open_firefox || open_chromium || open_default ;;
esac
